[Unit]
Description=Chenyu Amazon Crawler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/chenyu/chenyu-crawler
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/chenyu/chenyu-crawler/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8101
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
